# Local Docker Compose defaults. Copy to .env only when overriding these values.
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=123456

# Optional integrations. The application works locally without these.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Repeatable monitoring baseline workload.
K6_DURATION=2m
K6_BROWSE_VUS=5
K6_CHECKOUTS_PER_MINUTE=3
